# Copiez ce fichier vers .env.local et renseignez vos clés.
# Ces variables sont utilisées uniquement côté serveur (routes /api/*) :
# elles ne sont jamais exposées au navigateur.

# Clé API Mistral — https://console.mistral.ai
MISTRAL_API_KEY=

# Clé API ElevenLabs (voix de la prédiction) — https://elevenlabs.io (offre gratuite)
ELEVENLABS_API_KEY=
# Optionnel : ID d'une autre voix ElevenLabs (défaut = "Sarah")
ELEVENLABS_VOICE_ID=

# L 'ambiance sonore de fond est synthétisée dans le navigateur : aucune clé requise.
// Volume de la nappe synthétisée de fond (la voix reste au premier plan).  /* Ambiance de fond : file free of droits if present,  */                {/* Voix de la prédiction (ElevenLabs), piloté par toggleSpeech */}      <div className="relative z-10 min-h-screen pt-20 px-4 md:px-8">                <div className="relative w-24 h-36 sm:w-36 sm:h-56 md:w-48 md:h-72 rounded-2xl md:rounded-3xl overflow-hidden border-2 border-mystique-gold/50 shadow-2xl group-hover:border-mystique-gold/70 transition-all duration-500">          className="max-w-5xl mx-auto bg-black/40 backdrop-blur-sm rounded-2xl md:rounded-3xl p-6 sm:p-8 md:p-12 mb-16 border border-mystique-gold/20 relative overflow-hidden"            <div className="flex items-center justify-center sm:justify-start space-x-2 md:space-x-4 mb-8">      <div className="relative z-10 min-h-screen pt-20 px-4 md:px-8">              className="flex flex-wrap justify-center gap-4 sm:gap-8 md:gap-12 mb-16"                  <div className="w-24 h-36 sm:w-32 sm:h-52 md:w-40 md:h-64 relative">              <h2 className="text-2xl sm:text-3xl md:text-4xl font-bold text-mystique-gold mb-2 tracking-wider">          className="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 xl:grid-cols-11 gap-2 sm:gap-4 max-w-7xl mx-auto"      className={`relative cursor-pointer m-1 sm:m-3${        } w-full h-24 sm:h-32 relative`}