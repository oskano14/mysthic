# Copiez ce fichier vers .env.local et renseignez vos clés.
# Ces variables sont utilisées uniquement côté serveur (routes /api/*) :
# elles ne sont jamais exposées au navigateur.

# Clé API Mistral — https://console.mistral.ai
MISTRAL_API_KEY=

# Identifiants Spotify (compte développeur gratuit) — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Clé API ElevenLabs (voix de la prédiction) — https://elevenlabs.io (offers free)
ELEVENLABS_API_KEY=
# Optionnel : ID d'une autre voix ElevenLabs (défaut = "Sarah")
ELEVENLABS_VOICE_ID=
      const detail = await searchRes.text();